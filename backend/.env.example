# Copy to backend/.env for local development. Never commit real secrets.
ENVIRONMENT=development
# SQLite is used when DATABASE_URL is unset. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://hallplan:change-me@localhost:5432/hallplan
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=240
